# Database — local development (SQLite file).
# Also required on Vercel, where it is only read by `prisma generate` at
# build time; the running app uses the Turso variables below instead.
DATABASE_URL="file:./dev.db"

# Database — production / Vercel (Turso, hosted libSQL).
# A Function's filesystem is ephemeral and per-instance, so a SQLite file
# cannot be the production database. Set BOTH of these on Vercel; setting
# only one is rejected at startup (see src/lib/database-config.ts).
TURSO_DATABASE_URL="libsql://your-database-your-org.turso.io"
TURSO_AUTH_TOKEN="replace-with-the-turso-database-token"

# File uploads — production / Vercel (Vercel Blob, private store).
# Provisioned automatically when a Blob store is linked to the Vercel
# project. Local development writes to storage/uploads instead and does
# not need this.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"

# Auth — generate a strong random value for each secret, e.g.:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
SESSION_COOKIE_NAME="itmp_session"

# AES-256 key used to encrypt Credential Vault secrets (Module 4).
# Must be exactly 32 bytes. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY="replace-with-a-64-char-hex-string"

# Seed data — the single admin account (see prisma/seed.ts).
# ADMIN_PASSWORD_HASH is a bcrypt hash, never the plaintext password. Generate
# it with `npm run admin:hash-password` (prompts for the password on a masked
# line and prints only the hash) — the plaintext itself must never be put in
# this file, an env var, a command-line argument, or a log.
ADMIN_NAME="IT Administrator"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@company.com"
ADMIN_PASSWORD_HASH="replace-with-the-output-of-npm-run-admin-hash-password"

# SMTP — used for password resets, login OTP emails, and security alerts.
# Without these set, emails fall back to an on-screen link/message instead
# of failing silently. Example values for Microsoft 365 / Office 365:
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-mailbox@yourcompany.com"
SMTP_PASSWORD="replace-with-the-mailbox-password-or-app-password"
SMTP_FROM_NAME="IT Portal"
SMTP_FROM_EMAIL="your-mailbox@yourcompany.com"
