# Database
DATABASE_URL="file:./dev.db"

# Auth — generate a strong random value for each secret, e.g.:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
SESSION_COOKIE_NAME="itmp_session"

# AES-256 key used to encrypt Credential Vault secrets (Module 4).
# Must be exactly 32 bytes. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY="replace-with-a-64-char-hex-string"

# Seed data — the initial (and only) IT Administrator account.
ADMIN_NAME="IT Administrator"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@company.com"
ADMIN_PASSWORD="ChangeMe@123"

# SMTP — used for password resets, login OTP emails, and security alerts.
# Without these set, emails fall back to an on-screen link/message instead
# of failing silently. Example values for Microsoft 365 / Office 365:
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-mailbox@yourcompany.com"
SMTP_PASSWORD="replace-with-the-mailbox-password-or-app-password"
SMTP_FROM_NAME="IT Portal"
SMTP_FROM_EMAIL="your-mailbox@yourcompany.com"
